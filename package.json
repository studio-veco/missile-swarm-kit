{
  "name": "missile-swarm-kit",
  "version": "0.1.0",
  "description": "MISSILE SWARM: a browser viewer where a fighter dodges a homing missile swarm (pick the aircraft, stages, trajectory mix; re-solved on the spot), plus the open kit behind it: the swarm solver and procedural airframes for three.js",
  "homepage": "https://missile-swarm.pages.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/studio-veco/missile-swarm-kit.git"
  },
  "bugs": {
    "url": "https://github.com/studio-veco/missile-swarm-kit/issues"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./missiles": "./src/missiles.js",
    "./flight": "./src/flight.js",
    "./world": "./src/world.js",
    "./math": "./src/math.js",
    "./aircraft": "./src/aircraft/index.js"
  },
  "files": [
    "index.html",
    "app",
    "src",
    "vendor",
    "data",
    "skills",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node tools/serve.mjs 8177",
    "build": "sh tools/build.sh",
    "preview": "node tools/preview.mjs preview.png",
    "shot": "node tools/shot.mjs",
    "ui": "node tools/ui.mjs out/ui"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "three": "^0.170.0"
  },
  "keywords": [
    "three.js",
    "missile",
    "homing",
    "swarm-missiles",
    "procedural",
    "aircraft",
    "swarm",
    "animation"
  ],
  "license": "MIT"
}
